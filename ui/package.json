{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm type-check && vite build && vite build --config vite.frontend.config.ts",
    "type-check": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings && vue-tsc --noEmit -p tsconfig.app.json",
    "dev": "vite build --watch --mode development",
    "dev:frontend": "vite --config vite.frontend.config.ts",
    "test:unit": "vitest run --passWithNoTests",
    "format": "prettier --plugin=prettier-plugin-svelte --write src --ignore-path .prettierignore"
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.27.0",
    "@halo-dev/components": "^2.27.0",
    "@halo-dev/ui-shared": "^2.27.0",
    "axios": "^1.19.0",
    "bits-ui": "2.20.3",
    "svelte": "^5.57.3",
    "vue": "^3.5.40",
    "vue-router": "~5.1.0"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "name": "release-hub-ui"
}
